# FatigueGuard environment template. Copy to ".env" and fill in.
DATABASE_PATH=db/custom.db
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
PROCESSING_FPS=20
YAWN_MIN_DURATION_S=1.0
YAWN_RELEASE_DURATION_S=0.45
ALARM_RECOVERY_S=0.35

# SMTP email alerts (Gmail: STARTTLS on port 587; SSL on port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=FatigueGuard <your-email@gmail.com>
